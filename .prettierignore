# Golden snapshots are byte-exact tool output; formatting them breaks the tests.
**/__snapshots__/
# Citation test-case fixtures carry recorded digests; formatting changes the content and breaks digest tests.
tests/conformance/cases/
# Derived outputs are never formatted by hand.
.product/generated/
# Archify HTML and finalize receipts are generated from `.archify/` candidates; formatting them
# would change the validated artifact bytes and invalidate the Archify receipts.
/src/public-site/diagrams/
pnpm-lock.yaml
# Vendored v1alpha2 schemas retain the exact upstream bytes at their recorded revision.
schemas/v1alpha2/*.schema.json
src/packages/core/schemas/v1alpha2/*.schema.json
# Generated, managed AI-integration files are produced by the renderers, not hand-formatted;
# formatting them would break the installation-lock hashes (managed-file drift).
# openspec/config.yaml and .product/integrations/ are the OpenSpec renderer's managed outputs,
# reshaped by whatever openspec CLI version the release runner regenerates them with.
openspec/config.yaml
.product/integrations/
.claude/
# Agent Toolkit skills are package-managed source projections; formatting them changes lock hashes.
.agents/
.github/skills/
.github/prompts/
.github/hooks/
