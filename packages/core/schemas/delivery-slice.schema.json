{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-definition-as-code:schema:delivery-slice:v1alpha1",
  "title": "Delivery slice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "status",
    "product-change",
    "outcome",
    "implements",
    "verification"
  ],
  "properties": {
    "schema": { "const": "product-definition-as-code/delivery-slice/v1alpha1" },
    "id": {
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/deliverySliceId"
    },
    "title": { "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/title" },
    "status": {
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/deliverySliceStatus"
    },
    "product-change": {
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productChangeId"
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "implements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "coverage"],
        "properties": {
          "requirement": {
            "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/requirementId"
          },
          "coverage": { "enum": ["full", "partial"] },
          "scope": {
            "description": "Required when coverage is partial: the precise part of the requirement this slice covers.",
            "type": "string",
            "minLength": 1
          }
        },
        "if": {
          "properties": { "coverage": { "const": "partial" } }
        },
        "then": {
          "required": ["requirement", "coverage", "scope"]
        }
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productArtifactId"
      }
    },
    "depends-on": {
      "type": "array",
      "items": {
        "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/deliverySliceId"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "out-of-scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
