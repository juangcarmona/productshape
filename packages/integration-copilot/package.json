{
  "name": "@prodshape/integration-copilot",
  "version": "0.4.0-alpha.0",
  "description": "GitHub Copilot renderer for Product Definition as Code canonical assets.",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juangcarmona/productshape.git",
    "directory": "packages/integration-copilot"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0"
  }
}
