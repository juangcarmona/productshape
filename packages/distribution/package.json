{
  "name": "@prodshape/distribution",
  "version": "0.15.0",
  "description": "Installation, provider-asset generation, managed-file lifecycle and doctor for Product Definition as Code.",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juangcarmona/productshape.git",
    "directory": "packages/distribution"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prodshape/core": "workspace:*",
    "@prodshape/integration-claude": "workspace:*",
    "@prodshape/integration-codex": "workspace:*",
    "@prodshape/integration-copilot": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0"
  }
}
