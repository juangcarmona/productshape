{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-definition-as-code:schema:product-handoff:v1alpha1",
  "title": "Product handoff",
  "description": "Generated, framework-independent contract between Product Definition and an SDD framework. Non-canonical.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "generated-at",
    "work-item",
    "source",
    "implements",
    "affects",
    "artifacts",
    "context"
  ],
  "properties": {
    "schema": { "const": "product-definition-as-code/handoff/v1alpha1" },
    "id": {
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productHandoffId"
    },
    "generated-at": {
      "type": "string",
      "format": "date-time"
    },
    "work-item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "id", "title"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "product-change", "delivery-slice"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": {
          "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/gitRevision"
        },
        "product-change": {
          "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productChangeId"
        },
        "delivery-slice": {
          "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/deliverySliceId"
        }
      }
    },
    "implements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/requirementId"
      }
    },
    "affects": {
      "type": "array",
      "items": {
        "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productArtifactId"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path", "digest"],
        "properties": {
          "id": {
            "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productArtifactId"
          },
          "type": {
            "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productArtifactType"
          },
          "path": { "type": "string", "minLength": 1 },
          "digest": {
            "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/digest"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": {
          "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/digest"
        }
      }
    }
  }
}
