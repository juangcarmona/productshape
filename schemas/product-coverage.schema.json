{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-definition-as-code:schema:product-coverage:v1alpha1",
  "title": "Product coverage",
  "description": "Adapter-owned traceability mapping implemented requirements to SDD specifications and verification evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "handoff", "requirements"],
  "properties": {
    "schema": { "const": "product-definition-as-code/coverage/v1alpha1" },
    "handoff": {
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productHandoffId"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^(FR|QR|CON)-[A-Z0-9]+(-[A-Z0-9]+)*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["covered", "partial", "uncovered"] },
            "specification": {
              "description": "Required when status is covered or partial.",
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "verification": {
              "description": "Required when status is covered or partial.",
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "if": {
            "properties": { "status": { "enum": ["covered", "partial"] } }
          },
          "then": {
            "required": ["status", "specification", "verification"]
          }
        }
      }
    }
  }
}
