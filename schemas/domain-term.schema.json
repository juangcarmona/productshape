{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-definition-as-code:schema:domain-term:v1alpha1",
  "title": "Domain term frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "status", "defined-in"],
  "properties": {
    "id": { "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/domainTermId" },
    "type": { "const": "domain-term" },
    "title": { "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/title" },
    "status": {
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/artifactStatus"
    },
    "defined-in": {
      "description": "Canonical direction of term ownership. Bounded contexts never author owns-terms.",
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/boundedContextId"
    },
    "synonyms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/provenance"
    }
  }
}
