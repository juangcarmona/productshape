{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-definition-as-code:schema:product-change:v1alpha1",
  "title": "Product change frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "status", "base-revision", "operations"],
  "properties": {
    "id": {
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productChangeId"
    },
    "type": { "const": "product-change" },
    "title": { "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/title" },
    "status": {
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productChangeStatus"
    },
    "base-revision": {
      "description": "The baseline Git revision this change was created against.",
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/gitRevision"
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["add", "modify", "remove"],
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productArtifactId"
          }
        },
        "modify": {
          "type": "array",
          "items": {
            "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productArtifactId"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/productArtifactId"
          }
        }
      }
    }
  }
}
