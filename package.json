{
  "name": "productshape",
  "version": "0.1.0",
  "private": true,
  "description": "Define products as a versioned graph of Markdown artifacts. Project product knowledge into backlog and Spec-Driven Development through stable handoff contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:frontmatter": "tsx scripts/generate-frontmatter-reference.mts && prettier --write docs/specification/frontmatter-reference.md",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "version": "changeset version && pnpm build && node packages/cli/dist/bin.js integration update",
    "release": "changeset publish",
    "measure:snapshot": "tsx scripts/measure-snapshot.mts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@prodshape/cli": "workspace:*",
    "@prodshape/core": "workspace:*",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.5.0"
  }
}
