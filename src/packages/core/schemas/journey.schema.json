{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-definition-as-code:schema:journey:v1alpha1",
  "title": "Journey frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "status", "primary-actor", "steps"],
  "properties": {
    "id": { "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/journeyId" },
    "type": { "const": "journey" },
    "title": { "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/title" },
    "status": {
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/artifactStatus"
    },
    "primary-actor": {
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/actorId"
    },
    "steps": {
      "description": "The main ordered journey. Branches and exceptional paths belong in the body.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["use-case"],
        "properties": {
          "use-case": {
            "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/useCaseId"
          }
        }
      }
    },
    "provenance": {
      "$ref": "urn:product-definition-as-code:schema:common:v1alpha1#/$defs/provenance"
    }
  }
}
