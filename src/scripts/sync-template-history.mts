/**
 * Record the digest of every authoring template version ProductShape has ever shipped, so
 * `prodshape integration update` can tell a pristine installed copy (safe to refresh) from one an
 * adopter edited (kept). Reads Git history, so run it from a full clone:
 *
 *   pnpm templates:history
 *
 * Writes src/packages/distribution/src/template-history.ts. The current bundled version is
 * excluded: it is compared directly.
 */
import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import { readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const assetsDir = 'src/packages/distribution/assets/templates';
const out = 'src/packages/distribution/src/template-history.ts';
const git = (...args: string[]): string =>
  execFileSync('git', args, { encoding: 'utf8', maxBuffer: 1 << 28 });

const digest = (content: string): string =>
  `sha256:${createHash('sha256').update(content.replace(/\r\n?/g, '\n'), 'utf8').digest('hex')}`;

const history: Record<string, string[]> = {};
for (const name of readdirSync(assetsDir).sort()) {
  const current = digest(readFileSync(join(assetsDir, name), 'utf8'));
  const paths = [`templates/${name}`, `${assetsDir}/${name}`];
  const seen = new Set<string>();
  for (const path of paths) {
    const commits = git('log', '--all', '--format=%H', '--', path).split('\n').filter(Boolean);
    for (const commit of commits) {
      let content: string;
      try {
        content = git('show', `${commit}:${path}`);
      } catch {
        continue; // Deleted in this commit.
      }
      const value = digest(content);
      if (value !== current) seen.add(value);
    }
  }
  history[name] = [...seen].sort();
}

const body = Object.entries(history)
  .map(([name, digests]) => `  '${name}': [\n${digests.map((d) => `    '${d}',`).join('\n')}\n  ],`)
  .join('\n');
writeFileSync(
  out,
  `// GENERATED by src/scripts/sync-template-history.mts (pnpm templates:history). Do not edit.
/**
 * Digests of every earlier version of each bundled authoring template. An installed template
 * whose digest is listed here is an untouched copy of an older release and may be refreshed.
 */
export const shippedTemplateDigests: Readonly<Record<string, readonly string[]>> = {
${body}
};
`,
);
console.log(
  `Recorded ${Object.values(history).reduce((n, d) => n + d.length, 0)} earlier template version(s) in ${out}`,
);
